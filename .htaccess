Options -Indexes
Options +FollowSymLinks

# MIME types for static cPanel hosting.
AddType text/markdown .md
AddType text/markdown .markdown
AddType application/manifest+json .webmanifest
AddType image/x-icon .ico

# Force application/json for extensionless .well-known discovery files.
<FilesMatch "^(oauth-protected-resource|oauth-authorization-server|api-catalog|server-card)$">
    ForceType application/json
</FilesMatch>

# CORS for public discovery documents and markdown resources.
<IfModule mod_headers.c>
    <FilesMatch "\.(json|md)$">
        Header always set Access-Control-Allow-Origin "*"
        Header always set Access-Control-Allow-Methods "GET, OPTIONS"
        Header always set Access-Control-Allow-Headers "Accept, Content-Type"
    </FilesMatch>
    <FilesMatch "^(oauth-protected-resource|oauth-authorization-server|api-catalog)$">
        Header always set Access-Control-Allow-Origin "*"
        Header always set Access-Control-Allow-Methods "GET, OPTIONS"
        Header always set Access-Control-Allow-Headers "Accept, Content-Type"
        Header always set Cache-Control "public, max-age=3600"
    </FilesMatch>
</IfModule>

# Canonical production URL rules.
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Force HTTPS on cPanel/Apache.
    RewriteCond %{HTTPS} !=on
    RewriteRule ^ https://neptunetrading.lk%{REQUEST_URI} [R=301,L,NE]

    # Use the non-www production host consistently.
    RewriteCond %{HTTP_HOST} ^www\.neptunetrading\.lk$ [NC]
    RewriteRule ^ https://neptunetrading.lk%{REQUEST_URI} [R=301,L,NE]

    # Prefer the homepage root URL over the duplicate /index.html URL.
    RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
    RewriteRule ^index\.html$ https://neptunetrading.lk/ [R=301,L,NE]

    # Retired products: send discontinued product URLs to the range page so
    # existing inbound links and indexed results land somewhere useful.
    # Placed above the markdown rules so the .md counterpart redirects too.
    RewriteRule ^hummer-h3t(\.html|\.md)?$ https://neptunetrading.lk/hummer-products.html [R=301,L,NE]
    RewriteRule ^hummer-h2(\.html|\.md)?$ https://neptunetrading.lk/hummer-products.html [R=301,L,NE]

    # Markdown for Agents: serve .md counterparts when Accept: text/markdown.
    RewriteCond %{HTTP_ACCEPT} text/markdown
    RewriteRule ^$ /index.md [L]

    RewriteCond %{HTTP_ACCEPT} text/markdown
    RewriteRule ^([^/]+)\.html$ /$1.md [L,NC]

    RewriteCond %{HTTP_ACCEPT} text/markdown
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.md -f
    RewriteRule ^([^/]+)$ /$1.md [L,NC]

    # Block public access to repository and agent-internal directories.
    RewriteRule ^(\.git|\.claude|\.agents|\.impeccable)(/.*)?$ - [F,L]
</IfModule>

# Link response headers for public discovery resources.
<IfModule mod_headers.c>
    Header always set Link "</.well-known/api-catalog>; rel=\"api-catalog\", </.well-known/mcp/server-card.json>; rel=\"service-desc\", </auth.md>; rel=\"describedby\", </.well-known/oauth-protected-resource>; rel=\"oauth-protected-resource\""
</IfModule>

# Cache windows for static assets.
# Nothing on this site is content-hashed - product photos get replaced under
# their existing filenames - so a long immutable cache strands visitors on the
# old image with no way to recover. Images therefore get a short window with
# revalidation; CSS/JS and HTML always revalidate (set below).
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/png "access plus 1 day"
    ExpiresByType image/jpeg "access plus 1 day"
    ExpiresByType image/webp "access plus 1 day"
    ExpiresByType image/svg+xml "access plus 1 day"
    ExpiresByType image/x-icon "access plus 1 day"
    ExpiresByType application/manifest+json "access plus 1 week"
</IfModule>

# Explicit cache headers for common static file extensions.
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=0, must-revalidate"
    </FilesMatch>
    # HTML sent no Cache-Control at all before this, so each browser invented
    # its own freshness window and Safari held pages well past a deploy.
    <FilesMatch "\.(html|md)$">
        Header set Cache-Control "public, max-age=0, must-revalidate"
    </FilesMatch>
    <FilesMatch "\.(png|jpe?g|webp|svg|ico)$">
        Header set Cache-Control "public, max-age=86400, must-revalidate"
    </FilesMatch>
    <FilesMatch "^(site\.webmanifest|manifest\.json)$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>
</IfModule>

# Security headers for the static site.
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# php -- BEGIN cPanel-generated handler, do not edit
# This domain inherits the “PHP” package.
# php -- END cPanel-generated handler, do not edit
